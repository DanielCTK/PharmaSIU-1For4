<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#F2FFFFFF" />
            <stroke android:width="2dp" android:color="@color/emerald" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#D9FFFFFF" />
            <stroke android:width="1dp" android:color="@color/control_outline" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>

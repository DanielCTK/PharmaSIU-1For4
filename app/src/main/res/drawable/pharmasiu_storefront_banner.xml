<?xml version="1.0" encoding="utf-8"?>
<!-- PharmaSIU storefront photo supplied for the promotional/hero panels ONLY.
     This drawable is not used by product cards or merchandise photos. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/pharmasiu_storefront"
            android:gravity="fill"
            android:filter="true" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#BF09332C"
                android:centerColor="#770A3833"
                android:endColor="#260C392F" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/cream"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/staff_pos_product_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/staff_pos_product_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/staff_pos_product_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/emerald"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Chạm thẻ để xem chi tiết thông tin và tồn kho"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
        android:id="@+id/staff_pos_product_add"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/mint"
        android:text="+ Thêm vào giỏ"
        android:textAllCaps="false"
        android:textColor="@color/forest" />
</LinearLayout>

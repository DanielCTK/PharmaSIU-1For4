<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="132dp" android:paddingTop="14dp" android:orientation="vertical"
    android:clickable="true" android:focusable="true" android:background="@drawable/admin_modern_row">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="84dp" android:layout_height="100dp" android:layout_marginEnd="12dp">
            <FrameLayout android:id="@+id/admin_catalog_row_photo" android:layout_width="match_parent"
                android:layout_height="match_parent" android:background="@drawable/staff_product_photo"
                android:clipToOutline="true" />
            <ImageButton android:id="@+id/admin_catalog_row_photo_action" android:layout_width="48dp"
                android:layout_height="48dp" android:layout_gravity="bottom|end" android:padding="13dp"
                android:background="@drawable/admin_modern_icon" android:src="@drawable/admin_catalog_photo"
                android:contentDescription="Xem hoặc đổi ảnh sản phẩm" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/admin_catalog_row_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:breakStrategy="high_quality"
                android:hyphenationFrequency="none" android:textColor="@color/ink"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/admin_catalog_row_category" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:id="@+id/admin_catalog_row_sku" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/admin_catalog_row_price" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:textColor="@color/emerald" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/admin_catalog_row_stock" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="@color/ink" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/admin_catalog_row_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="@color/emerald" android:textSize="13sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="14dp" android:background="@color/line" android:importantForAccessibility="no" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView android:id="@+id/staff_pos_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="PHARMASIU  /  QUẦY BÁN LẺ POS"
                android:textColor="@color/lime"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Bán hàng tại quầy"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/staff_pos_shift_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chưa mở ca bán hàng"
                android:textColor="@color/mint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hệ thống bán hàng và thanh toán quầy thu ngân PharmaSIU."
                android:textColor="@color/mint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/staff_pos_denied"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="Bạn không có quyền sử dụng POS. Vui lòng đăng nhập tài khoản nhân viên hoặc quản lý."
            android:textColor="@color/warning"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/staff_pos_shift_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="01  /  Ca làm việc"
                android:textColor="@color/forest"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/staff_pos_open_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tiền đầu ca (VNĐ)"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <EditText
                    android:background="@drawable/component_input_outline" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColorHint="@color/muted" android:id="@+id/staff_pos_opening_cash"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="Tiền đầu ca giả lập"
                    android:hint="Ví dụ: 100000"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="12"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                    android:id="@+id/staff_pos_open_shift"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/emerald"
                    android:text="Mở ca bán hàng"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/staff_pos_active_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/staff_pos_shift_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                    android:id="@+id/staff_pos_close_shift"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/mint"
                    android:text="Đóng ca bán hàng"
                    android:textAllCaps="false"
                    android:textColor="@color/forest" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ghi nhận số dư tiền mặt đầu ca để đối soát khi đóng ca."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/staff_pos_sales_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="02  /  Chọn sản phẩm"
                    android:textColor="@color/forest"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:background="@drawable/component_input_outline" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColorHint="@color/muted" android:id="@+id/staff_pos_search"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Tìm theo tên mã hoặc nhóm sản phẩm"
                    android:hint="Tìm tên, mã hoặc nhóm hàng"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/staff_pos_search_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                    android:id="@+id/staff_pos_cart_jump"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/emerald"
                    android:text="Xem giỏ hàng và thanh toán (0)"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:id="@+id/staff_pos_products"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="03  /  Giỏ hàng thanh toán"
                    android:textColor="@color/forest"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/staff_pos_cart_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/staff_pos_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tạm tính: 0 ₫"
                    android:textColor="@color/emerald"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                    android:id="@+id/staff_pos_clear_cart"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/mint"
                    android:text="Hủy giỏ đang lập"
                    android:textAllCaps="false"
                    android:textColor="@color/forest" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="04  /  Lưu phiếu bán mẫu"
                    android:textColor="@color/forest"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Phương thức ghi trên phiếu (không xác minh thanh toán)"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/staff_pos_payment_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/staff_pos_cash"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:buttonTint="@color/emerald"
                        android:checked="true"
                        android:text="Tiền mặt giả lập"
                        android:textColor="@color/ink" />

                    <RadioButton
                        android:id="@+id/staff_pos_other"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:buttonTint="@color/emerald"
                        android:text="Chuyển khoản / Thẻ ngân hàng"
                        android:textColor="@color/ink" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/staff_pos_cash_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:background="@drawable/component_input_outline" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColorHint="@color/muted" android:id="@+id/staff_pos_cash_tender"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:contentDescription="Số tiền mặt giả định khách đưa"
                        android:hint="Số tiền giả định khách đưa (VNĐ)"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="12"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/staff_pos_change"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Tiền thối thử: 0 ₫"
                        android:textColor="@color/emerald"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/staff_pos_payment_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/warning"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                    android:id="@+id/staff_pos_save_sale"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/emerald"
                    android:text="Thanh toán &amp; Xuất hóa đơn"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Không bán Rx; chưa có xác minh thu tiền, giao thuốc hoặc chứng từ thật."
                    android:textColor="@color/warning"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/staff_pos_receipt_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="HÓA ĐƠN ĐÃ LẬP"
                android:textColor="@color/emerald"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/staff_pos_receipt_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/forest"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/staff_pos_receipt_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/staff_pos_receipt_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/forest"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/staff_pos_receipt_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Phiếu này không xác nhận đã thu tiền, xuất kho thật hoặc bàn giao hàng."
                android:textColor="@color/warning"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                android:id="@+id/staff_pos_receipt_dismiss"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/mint"
                android:text="Tiếp tục bán thử"
                android:textAllCaps="false"
                android:textColor="@color/forest" />

            <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                android:id="@+id/staff_pos_receipt_history"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/mint"
                android:text="Xem lịch sử hóa đơn"
                android:textAllCaps="false"
                android:textColor="@color/forest" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Hóa đơn trong ca làm việc"
                android:textColor="@color/forest"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/staff_pos_history_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Chưa có giao dịch trong ca"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/staff_pos_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton app:cornerRadius="0dp"
                android:id="@+id/staff_pos_history_more"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:backgroundTint="@color/mint"
                android:text="Xem thêm hóa đơn"
                android:textAllCaps="false"
                android:textColor="@color/forest"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hệ thống bán hàng quầy POS PharmaSIU kết nối trực tiếp quản lý kho thuốc."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <ImageButton
        android:id="@+id/staff_pos_scroll_top"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_scroll_top"
        android:src="@drawable/ic_arrow_up"
        android:elevation="6dp"
        android:contentDescription="Cuộn lên đầu trang POS"
        android:visibility="gone" />
</FrameLayout>

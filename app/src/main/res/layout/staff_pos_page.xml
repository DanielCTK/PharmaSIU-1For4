<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ui_workspace_canvas" android:orientation="vertical">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ScrollView android:id="@+id/staff_pos_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/staff_pos_header" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:text="Bán hàng tại quầy" android:textColor="@color/white"
            android:textSize="25sp" android:accessibilityHeading="true" />
        <TextView android:id="@+id/staff_pos_shift_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/staff_pos_shift_badge"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:fontFamily="sans-serif-medium" android:text="Chưa mở ca bán hàng" android:textColor="@color/forest" android:textSize="13sp" />
        <TextView android:id="@+id/staff_pos_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Lập phiếu demo trên thiết bị." android:textColor="@color/white" android:textSize="14sp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:paddingHorizontal="16dp">
      <TextView android:id="@+id/staff_pos_denied" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:text="Bạn không có quyền sử dụng POS. Vui lòng đăng nhập tài khoản nhân viên hoặc quản lý." android:textColor="@color/warning" android:textSize="15sp" android:visibility="gone" />
      <LinearLayout android:id="@+id/staff_pos_shift_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/staff_pos_section" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/staff_pos_shift_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Ca làm việc" android:textColor="@color/forest" android:textSize="18sp" android:accessibilityHeading="true" />
        <LinearLayout android:id="@+id/staff_pos_open_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiền đầu ca (VNĐ)" android:textColor="@color/muted" android:textSize="14sp" />
          <EditText android:background="@drawable/component_input_outline" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColorHint="@color/muted" android:id="@+id/staff_pos_opening_cash" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="14dp" android:contentDescription="Tiền đầu ca" android:hint="Ví dụ: 100000" android:imeOptions="actionDone" android:inputType="number" android:maxLength="12" android:singleLine="true" android:text="0" android:textColor="@color/ink" android:textSize="16sp" />
          <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_open_shift" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/emerald" android:text="Mở ca bán hàng" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:paddingVertical="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/staff_pos_active_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:orientation="vertical" android:visibility="gone">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/staff_pos_shift_balance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:textColor="@color/forest" android:textSize="14sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton"
                android:id="@+id/staff_pos_shift_details_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="Chi tiết ca" android:textAllCaps="false" android:textColor="@color/emerald" android:textSize="14sp"
                app:icon="@drawable/component_chevron_down" app:iconGravity="textEnd" app:iconSize="18dp" app:iconTint="@color/emerald" />
          </LinearLayout>
          <LinearLayout android:id="@+id/staff_pos_shift_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/staff_pos_shift_financial_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="2dp" android:textColor="@color/muted" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_close_shift" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:backgroundTint="@color/mint" android:text="Đóng ca bán hàng" android:textAllCaps="false" android:textColor="@color/forest" android:textSize="16sp" android:paddingVertical="12dp" />
          </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/staff_pos_opening_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ghi nhận số dư tiền mặt đầu ca để đối soát khi đóng ca." android:textColor="@color/muted" android:textSize="14sp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/staff_pos_sales_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/staff_pos_section" android:orientation="vertical" android:padding="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Chọn sản phẩm" android:textColor="@color/forest" android:textSize="19sp" android:accessibilityHeading="true" />
          <EditText android:id="@+id/staff_pos_search" android:layout_width="match_parent" android:layout_height="wrap_content"
              android:minHeight="50dp" android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:paddingVertical="10dp"
              android:background="@drawable/staff_pos_search_surface" android:drawableStart="@drawable/ic_search"
              android:drawablePadding="8dp" android:textColorHint="@color/muted"
              android:contentDescription="Tìm theo tên, mã hoặc nhóm sản phẩm" android:hint="Tìm tên, mã hoặc nhóm hàng"
              android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true"
              android:textColor="@color/ink" android:textSize="15sp" />
          <TextView android:id="@+id/staff_pos_search_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="13sp" />
          <LinearLayout android:id="@+id/staff_pos_products" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
        <LinearLayout android:id="@+id/staff_pos_cart_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/staff_pos_section" android:orientation="vertical" android:padding="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Giỏ hàng" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
          <LinearLayout android:id="@+id/staff_pos_cart_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
          <TextView android:id="@+id/staff_pos_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:fontFamily="sans-serif-medium" android:text="Tạm tính: 0 ₫" android:textColor="@color/emerald" android:textSize="20sp" android:textStyle="bold" />
          <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_clear_cart" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/mint" android:text="Hủy giỏ đang lập" android:textAllCaps="false" android:textColor="@color/forest" android:textSize="16sp" android:paddingVertical="12dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/staff_pos_section" android:orientation="vertical" android:padding="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Lưu phiếu bán hàng" android:textColor="@color/forest" android:textSize="18sp" android:accessibilityHeading="true" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Phương thức ghi trên phiếu (không xác minh thanh toán)" android:textColor="@color/muted" android:textSize="14sp" />
          <RadioGroup android:id="@+id/staff_pos_payment_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/staff_pos_cash" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:buttonTint="@color/emerald" android:checked="true" android:text="Tiền mặt" android:textColor="@color/ink" />
            <RadioButton android:id="@+id/staff_pos_other" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:buttonTint="@color/emerald" android:text="Khác (demo, chưa xác minh)" android:textColor="@color/ink" />
          </RadioGroup>
          <LinearLayout android:id="@+id/staff_pos_cash_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:background="@drawable/component_input_outline" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColorHint="@color/muted" android:id="@+id/staff_pos_cash_tender" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="14dp" android:contentDescription="Số tiền khách đưa" android:hint="Số tiền khách đưa (VNĐ)" android:imeOptions="actionDone" android:inputType="number" android:maxLength="12" android:singleLine="true" android:textColor="@color/ink" android:textSize="15sp" />
            <TextView android:id="@+id/staff_pos_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Tiền thừa trả khách: 0 ₫" android:textColor="@color/emerald" android:textSize="15sp" />
          </LinearLayout>
          <TextView android:id="@+id/staff_pos_payment_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/warning" android:textSize="14sp" android:visibility="gone" />
          <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_save_sale" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/emerald" android:text="Lưu phiếu bán hàng demo" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:paddingVertical="12dp" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/staff_pos_receipt_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/staff_pos_section" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="HÓA ĐƠN ĐÃ LẬP" android:textColor="@color/emerald" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/staff_pos_receipt_reference" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/forest" android:textSize="21sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/staff_pos_receipt_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        <TextView android:id="@+id/staff_pos_receipt_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/forest" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/staff_pos_receipt_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Phiếu demo cục bộ, không thay thế hóa đơn thật." android:textColor="@color/muted" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_receipt_dismiss" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:backgroundTint="@color/mint" android:text="Tiếp tục bán hàng" android:textAllCaps="false" android:textColor="@color/forest" android:textSize="16sp" android:paddingVertical="12dp" />
        <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_receipt_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/mint" android:text="Xem lịch sử hóa đơn" android:textAllCaps="false" android:textColor="@color/forest" android:textSize="16sp" android:paddingVertical="12dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/staff_pos_section" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Hóa đơn trong ca làm việc" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/staff_pos_history_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Chưa có giao dịch trong ca" android:textColor="@color/muted" android:textSize="14sp" />
        <LinearLayout android:id="@+id/staff_pos_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton app:cornerRadius="14dp" android:id="@+id/staff_pos_history_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="9dp" android:backgroundTint="@color/mint" android:text="Xem thêm hóa đơn" android:textAllCaps="false" android:textColor="@color/forest" android:visibility="gone" android:textSize="16sp" android:paddingVertical="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Dữ liệu lưu trên thiết bị, chưa đồng bộ nhiều quầy." android:textColor="@color/muted" android:textSize="14sp" />
      </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <ImageButton android:id="@+id/staff_pos_scroll_top" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_marginEnd="18dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_scroll_top" android:src="@drawable/ic_arrow_up" android:elevation="6dp" android:contentDescription="Cuộn lên đầu trang POS" android:visibility="gone" />
  </FrameLayout>
  <LinearLayout android:id="@+id/staff_pos_cart_dock"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:background="@color/white" android:visibility="gone">
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/ui_surface_divider" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="6dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tạm tính" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:id="@+id/staff_pos_dock_total"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/forest" android:textSize="17sp" android:textStyle="bold" />
      </LinearLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/staff_pos_cart_jump"
          android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
          android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
          android:backgroundTint="@color/emerald" android:text="Xem giỏ" android:textAllCaps="false"
          android:textColor="@color/white" android:textSize="14sp"
          app:cornerRadius="10dp" app:icon="@drawable/nav_cart" app:iconSize="19dp" app:iconTint="@color/white" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>

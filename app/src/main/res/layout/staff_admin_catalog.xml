<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="36dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HÀNG HÓA NỘI BỘ"
                android:textColor="@color/lime"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.09" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tên và giá tham khảo."
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chỉnh thông tin hoặc tạo mặt hàng OTC mẫu. Không đồng bộ với danh mục khách thật."
                android:textColor="@color/mint"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/staff_admin_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

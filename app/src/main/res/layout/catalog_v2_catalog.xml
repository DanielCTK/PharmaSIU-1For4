<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="36dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingHorizontal="16dp" android:paddingVertical="12dp">
            <TextView android:id="@+id/catalog_v2_catalog_back"
                android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_arrow_back"
                android:drawableLeft="@drawable/ic_arrow_back"
                android:paddingStart="10dp"
                android:paddingLeft="10dp"
                android:textColor="@color/emerald"
                android:contentDescription="Về trang chủ"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Danh mục sản phẩm" android:gravity="center_vertical"
                android:textColor="@color/forest" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="180dp"
            android:background="@drawable/catalog_v2_hero">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingVertical="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="TỦ ĐỒ CHĂM SÓC" android:letterSpacing="0.15"
                    android:textColor="@color/lime" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Chọn đúng\nđiều bạn cần."
                    android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold"/>
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
                <TextView android:id="@+id/catalog_v2_catalog_hero_count"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/mint" android:textSize="12sp"/>
            </LinearLayout>
        </FrameLayout>
        <EditText android:id="@+id/catalog_v2_catalog_search" android:layout_width="match_parent"
            android:layout_height="50dp" android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp" android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="16dp" android:hint="Tìm tên, danh mục hoặc nhu cầu..."
            android:drawableStart="@drawable/ic_search"
            android:drawableLeft="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text"
            android:textColor="@color/ink" android:textSize="14sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="6dp"
            android:text="Tra cứu thuốc, thực phẩm chức năng và vật tư y tế chính hãng." android:textColor="@color/muted"
            android:textSize="11sp"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:id="@+id/catalog_v2_catalog_filters"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"/>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="14dp"
            android:background="@drawable/catalog_v2_surface" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sản phẩm" android:textColor="@color/emerald"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/catalog_v2_catalog_results_count"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/muted" android:textSize="11sp"/>
            </LinearLayout>
            <Spinner android:id="@+id/catalog_v2_catalog_sort"
                android:layout_width="142dp" android:layout_height="48dp"
                android:contentDescription="Sắp xếp sản phẩm"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/catalog_v2_catalog_grid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp"/>
        <com.google.android.material.button.MaterialButton
            app:cornerRadius="14dp"
            android:id="@+id/catalog_v2_catalog_reset"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
            android:backgroundTint="@color/mint" android:text="Xóa bộ lọc"
            android:textAllCaps="false" android:textColor="@color/emerald"
            android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp"
            android:background="@drawable/catalog_v2_surface" android:padding="14dp"
            android:text="PharmaSIU · Đội ngũ dược sĩ chuyên môn cao tư vấn sử dụng thuốc 24/7."
            android:textColor="@color/warning" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView android:clipToPadding="false" android:id="@+id/staff_admin_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="100dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="22dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/staff_admin_btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/auth_field"
                    android:backgroundTint="@color/forest"
                    android:text="‹ Tổng quan"
                    android:textColor="@color/lime"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUẢN LÝ LÔ &amp; HẠN DÙNG"
                    android:textColor="@color/lime"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />
                <TextView
                    android:id="@+id/staff_admin_btn_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/auth_field"
                    android:backgroundTint="@color/forest"
                    android:text="🚪 Đăng xuất"
                    android:textColor="@color/lime"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rõ lô, rõ điều kiện."
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Quản lý nhập lô hàng và cách ly sản phẩm quá hạn hoặc không đủ tiêu chuẩn."
                android:textColor="@color/mint"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/staff_admin_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

    <ImageButton
        android:id="@+id/staff_admin_scroll_top"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_scroll_top"
        android:src="@drawable/ic_arrow_up"
        android:elevation="6dp"
        android:contentDescription="Cuộn lên đầu trang"
        android:visibility="gone" />
</FrameLayout>

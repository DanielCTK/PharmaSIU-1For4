<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/catalog_v2_surface"
    android:clipToOutline="true" android:orientation="vertical">
    <FrameLayout android:id="@+id/catalog_v2_card_media"
        android:layout_width="match_parent" android:layout_height="168dp">
        <TextView android:id="@+id/catalog_v2_card_category"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="start|top" android:layout_margin="8dp"
            android:background="@drawable/catalog_v2_chip" android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" android:textColor="@color/emerald"
            android:textSize="9sp" android:textStyle="bold" android:maxLines="1"/>
        <TextView android:id="@+id/catalog_v2_card_favorite"
            android:layout_width="38dp" android:layout_height="38dp"
            android:layout_gravity="end|top" android:layout_margin="8dp"
            android:background="@drawable/bg_favorite_circle"
            android:contentDescription="Yêu thích" android:gravity="center"
            android:padding="7dp"
            android:text="" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="130dp" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/catalog_v2_card_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end" android:textColor="@color/ink"
            android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/catalog_v2_card_subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:ellipsize="end" android:maxLines="2" android:textColor="@color/muted"
            android:textSize="11sp"/>
        <TextView android:id="@+id/catalog_v2_card_price" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="@color/emerald" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/catalog_v2_card_caveat" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:maxLines="2" android:textColor="@color/muted" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>

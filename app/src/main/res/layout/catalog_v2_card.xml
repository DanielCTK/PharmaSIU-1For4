<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:clickable="true" android:focusable="true"
    android:background="@drawable/catalog_market_card_focus" android:foreground="?attr/selectableItemBackground">
    <FrameLayout android:id="@+id/catalog_v2_card_media" android:layout_width="match_parent"
        android:layout_height="156dp" android:background="@drawable/catalog_v2_photo_surface"
        android:clipToOutline="true">
        <TextView android:id="@+id/catalog_v2_card_category" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="start|top" android:layout_marginStart="7dp" android:layout_marginTop="9dp"
            android:background="@drawable/catalog_redesign_category_tag" android:paddingHorizontal="8dp" android:paddingVertical="4dp"
            android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
        <TextView android:id="@+id/catalog_v2_card_favorite" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="end|top" android:layout_margin="4dp" android:padding="13dp"
            android:background="@drawable/catalog_market_icon_surface" android:contentDescription="Yêu thích"
            android:gravity="center" android:clickable="true" android:focusable="true"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/catalog_v2_card_add"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="end|bottom" android:layout_margin="4dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="+" android:textSize="23sp" android:textAllCaps="false"
            android:backgroundTint="@color/emerald" android:textColor="@color/white" app:cornerRadius="24dp"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="8dp" android:paddingHorizontal="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/catalog_v2_card_price" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/emerald"
            android:textSize="19sp" android:textStyle="bold"/>
        <TextView android:id="@+id/catalog_v2_card_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/ink"
            android:lineSpacingExtra="2dp" android:breakStrategy="high_quality" android:hyphenationFrequency="none"
            android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/catalog_v2_card_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>

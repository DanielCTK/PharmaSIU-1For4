<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="15dp">
        <ImageView android:id="@+id/catalog_v2_product_back"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_favorite_circle"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/forest"
            android:scaleType="centerInside"
            android:contentDescription="Quay lại danh mục"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Chi tiết sản phẩm"
            android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/catalog_v2_product_favorite"
            android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
            android:background="@drawable/bg_favorite_circle"
            android:contentDescription="Lưu sản phẩm yêu thích"
            android:padding="8dp"/>
    </LinearLayout>
    <ScrollView android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="100dp">
            <FrameLayout android:id="@+id/catalog_v2_product_media"
                android:layout_width="match_parent" android:layout_height="280dp"
                android:layout_marginHorizontal="16dp"
                android:clipToOutline="true"
                android:background="@drawable/catalog_v2_surface">
                <TextView android:id="@+id/catalog_v2_product_media_tag"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|start" android:layout_margin="16dp"
                    android:background="@drawable/catalog_v2_chip"
                    android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                    android:textColor="@color/emerald" android:textSize="10sp"
                    android:textStyle="bold"/>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="19dp">
                <TextView android:id="@+id/catalog_v2_product_category"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:letterSpacing="0.12" android:textColor="@color/emerald"
                    android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/catalog_v2_product_name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:textColor="@color/forest"
                    android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:id="@+id/catalog_v2_product_subtitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textColor="@color/muted"
                    android:textSize="13sp"/>
                <TextView android:id="@+id/catalog_v2_product_price"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="17dp" android:textColor="@color/emerald"
                    android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/catalog_v2_product_price_note"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/muted"
                    android:textSize="12sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:background="@drawable/catalog_v2_surface"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="CÔNG DỤNG &amp; MÔ TẢ"
                        android:textColor="@color/emerald" android:textSize="11sp" android:textStyle="bold"
                        android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/catalog_v2_product_description"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ink" android:textSize="14sp"
                        android:lineSpacingExtra="3dp"/>
                    <View
                        android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#15000000"/>
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="THÔNG TIN CHI TIẾT"
                        android:textColor="@color/emerald" android:textSize="11sp" android:textStyle="bold"
                        android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/catalog_v2_product_ingredients"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="@color/forest"
                        android:textSize="13sp" android:lineSpacingExtra="2dp"/>
                    <TextView android:id="@+id/catalog_v2_product_spec"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="@color/muted"
                        android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/catalog_v2_product_food_caveat"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:background="@drawable/catalog_v2_surface"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:textColor="@color/forest" android:textSize="12sp"/>
                <TextView android:id="@+id/catalog_v2_product_process"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:background="@drawable/catalog_v2_surface"
                    android:padding="14dp"
                    android:textColor="@color/forest" android:textSize="12sp"/>
                <com.google.android.material.button.MaterialButton
                    app:cornerRadius="14dp"
                    android:id="@+id/catalog_v2_product_back_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/mint"
                    android:text="← Quay lại danh mục"
                    android:textAllCaps="false"
                    android:textColor="@color/forest"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:orientation="vertical"
        android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton
            app:cornerRadius="14dp"
            android:id="@+id/catalog_v2_product_add"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:backgroundTint="@color/emerald" android:text="Thêm vào giỏ hàng"
            android:textAllCaps="false" android:textColor="@color/white"
            android:textStyle="bold"/>
        <TextView android:id="@+id/catalog_v2_product_cta_note"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:gravity="center"
            android:text="Chưa xác nhận đặt trước hoặc giữ hàng."
            android:textColor="@color/muted" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:importantForAutofill="no">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="PharmaSIU" android:textColor="@color/emerald"
                    android:textSize="23sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="CHĂM SÓC · MUA SẮM · VẬN HÀNH"
                    android:textColor="@color/muted" android:textSize="9sp"
                    android:letterSpacing="0.07" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/auth_mint_panel" android:paddingStart="10dp"
                android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                android:text="HỆ THỐNG NHÀ THUỐC" android:textColor="@color/emerald"
                android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="228dp"
            android:background="@drawable/auth_hero">
            <View android:layout_width="240dp" android:layout_height="240dp"
                android:layout_gravity="right|top" android:layout_marginTop="-42dp"
                android:layout_marginEnd="-60dp" android:background="@drawable/auth_orbit" android:visibility="gone"
                android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:paddingStart="23dp"
                android:paddingEnd="23dp" android:paddingTop="23dp" android:paddingBottom="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✦  PHARMASIU  /  WELCOME" android:textColor="@color/lime"
                    android:textSize="11sp" android:letterSpacing="0.06" android:textStyle="bold"/>
                <Space android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Chào mừng&#10;trở lại." android:lineSpacingExtra="1dp"
                    android:textColor="@color/white" android:textSize="34sp"
                    android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Một tài khoản. Đúng không gian dành cho bạn."
                    android:textColor="@color/mint" android:textSize="13sp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp"
            android:paddingEnd="20dp" android:paddingTop="22dp">
            <TextView android:id="@+id/auth_mode_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Đăng nhập PharmaSIU"
                android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/auth_mode_subtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:text="Dành cho khách hàng, nhân viên và quản lý."
                android:textColor="@color/muted" android:textSize="14sp"/>
            <LinearLayout android:id="@+id/auth_roles" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:orientation="vertical" android:padding="15dp"
                android:background="@drawable/auth_mint_panel">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="MỘT ĐĂNG NHẬP  /  BA VAI TRÒ" android:letterSpacing="0.06"
                    android:textColor="@color/forest" android:textSize="11sp"
                    android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center"
                    android:layout_marginTop="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="60dp"
                        android:layout_weight="1" android:gravity="center" android:text="Khách hàng"
                        android:textColor="@color/forest" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="60dp"
                        android:layout_weight="1" android:gravity="center" android:text="Nhân viên"
                        android:textColor="@color/forest" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="60dp"
                        android:layout_weight="1" android:gravity="center" android:text="Quản lý"
                        android:textColor="@color/forest" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:lineSpacingExtra="2dp"
                    android:text="Vai trò được xác định từ tài khoản đã lưu trong cơ sở dữ liệu."
                    android:textColor="@color/muted" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/auth_name_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="17dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:labelFor="@id/auth_name" android:text="Họ và tên"
                    android:textColor="@color/forest" android:textStyle="bold" android:textSize="13sp"/>
                <EditText android:id="@+id/auth_name" android:layout_width="match_parent"
                    android:layout_height="56dp" android:layout_marginTop="7dp"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:background="@drawable/auth_field" android:hint="Nguyễn Văn An"
                    android:inputType="textPersonName|textCapWords" android:maxLength="70"
                    android:singleLine="true" android:imeOptions="actionNext"
                    android:textColor="@color/ink" android:textColorHint="@color/muted"
                    android:textSize="15sp"/>
            </LinearLayout>
            <TextView android:id="@+id/auth_identifier_label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:labelFor="@id/auth_identifier"
                android:text="Email hoặc số điện thoại" android:textColor="@color/forest"
                android:textSize="13sp" android:textStyle="bold"/>
            <EditText android:id="@+id/auth_identifier" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="7dp"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/auth_field" android:hint="Email / 0900000000"
                android:inputType="textEmailAddress" android:maxLength="120"
                android:singleLine="true" android:imeOptions="actionNext"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="15dp" android:labelFor="@id/auth_password"
                android:text="Mật khẩu" android:textColor="@color/forest"
                android:textSize="13sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="7dp">
                <EditText android:id="@+id/auth_password" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:background="@drawable/auth_field"
                    android:paddingStart="14dp" android:paddingEnd="90dp"
                    android:inputType="textPassword" android:maxLength="64"
                    android:imeOptions="actionDone" android:singleLine="true"
                    android:textColor="@color/ink" android:textColorHint="@color/muted"
                    android:textSize="15sp"/>
                <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_toggle_password" android:layout_width="80dp"
                    android:layout_height="52dp" android:layout_gravity="end|center_vertical"
                    android:text="Hiện" android:textAllCaps="false" android:textSize="13sp"
                    android:contentDescription="Hiện mật khẩu"
                    android:textColor="@color/emerald" android:backgroundTint="@color/mint"/>
            </FrameLayout>
            <LinearLayout android:id="@+id/auth_confirm_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="15dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:labelFor="@id/auth_password_confirm" android:text="Nhập lại mật khẩu"
                    android:textColor="@color/forest" android:textSize="13sp" android:textStyle="bold"/>
                <EditText android:id="@+id/auth_password_confirm" android:layout_width="match_parent"
                    android:layout_height="56dp" android:layout_marginTop="7dp"
                    android:background="@drawable/auth_field" android:paddingStart="14dp"
                    android:paddingEnd="14dp" android:inputType="textPassword" android:maxLength="64"
                    android:singleLine="true" android:imeOptions="actionDone"
                    android:textColor="@color/ink" android:textColorHint="@color/muted"
                    android:textSize="15sp"/>
            </LinearLayout>
            <TextView android:id="@+id/auth_success" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:padding="13dp" android:background="@drawable/auth_mint_panel"
                android:textColor="@color/emerald" android:textSize="13sp"
                android:accessibilityLiveRegion="polite" android:visibility="gone"/>
            <TextView android:id="@+id/auth_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:padding="13dp" android:background="@drawable/auth_warning_panel"
                android:textColor="@color/warning" android:textSize="13sp"
                android:accessibilityLiveRegion="assertive" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_submit" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="17dp"
                android:text="Đăng nhập" android:textSize="15sp" android:textStyle="bold"
                android:textAllCaps="false" android:textColor="@color/white"
                android:backgroundTint="@color/emerald"/>
            <LinearLayout android:id="@+id/auth_mode_actions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="5dp">
                <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_register" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="52dp"
                    android:text="Tạo tài khoản" android:textAllCaps="false"
                    android:textSize="13sp" android:textColor="@color/emerald"
                    android:backgroundTint="@color/cream"/>
                <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_forgot" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="52dp"
                    android:text="Quên mật khẩu?" android:textAllCaps="false"
                    android:textSize="13sp" android:textColor="@color/emerald"
                    android:backgroundTint="@color/cream"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_back" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="5dp"
                android:text="← Trở lại đăng nhập" android:textAllCaps="false"
                android:textColor="@color/emerald" android:backgroundTint="@color/cream"
                android:visibility="gone"/>
            <LinearLayout android:id="@+id/auth_demo_panel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="13dp" android:orientation="vertical"
                android:background="@drawable/auth_card">
                <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_demo_toggle"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="Thông tin tài khoản" android:textAllCaps="false"
                    android:contentDescription="Thông tin tài khoản"
                    android:textColor="@color/emerald" android:textStyle="bold"
                    android:backgroundTint="@color/white"/>
                <LinearLayout android:id="@+id/auth_demo_accounts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_demo_customer"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:text="Khách hàng · 0900000000"
                        android:textAllCaps="false" android:textColor="@color/forest"
                        android:backgroundTint="@color/mint"/>
                    <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_demo_cashier"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="6dp" android:text="Nhân viên quầy (Thu ngân)"
                        android:textAllCaps="false" android:textColor="@color/forest"
                        android:backgroundTint="@color/mint"/>
                    <com.google.android.material.button.MaterialButton app:cornerRadius="12dp" android:id="@+id/auth_demo_manager"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="6dp" android:text="Quản trị viên (Admin)"
                        android:textAllCaps="false" android:textColor="@color/forest"
                        android:backgroundTint="@color/mint"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:padding="5dp"
                        android:text="Tài khoản hệ thống"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/muted" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/auth_disclaimer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:lineSpacingExtra="3dp"
                android:text="Bảo mật thông tin: Hệ thống nhà thuốc PharmaSIU cam kết bảo mật tuyệt đối thông tin tài khoản và dữ liệu người dùng theo quy định y tế."
                android:textColor="@color/muted" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/catalog_header_gradient" android:paddingBottom="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="PharmaSIU" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold"
            android:drawableStart="@drawable/home_brand_mark" android:drawablePadding="10dp" android:gravity="center_vertical"/>
        <TextView android:id="@+id/catalog_v2_home_cart" android:layout_width="wrap_content"
            android:layout_height="48dp" android:minWidth="48dp" android:gravity="center"
            android:paddingHorizontal="12dp" android:background="@drawable/catalog_redesign_icon_button"
            android:drawablePadding="5dp" android:contentDescription="Mở giỏ hàng"
            android:textColor="@color/emerald" android:textSize="14sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <TextView android:id="@+id/catalog_v2_home_search" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginHorizontal="12dp"
        android:background="@drawable/catalog_market_search_surface"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
        android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp"
        android:text="Tìm sản phẩm…" android:textColor="@color/muted" android:textSize="16sp"
        android:clickable="true" android:focusable="true" android:contentDescription="Tìm kiếm sản phẩm trong danh mục"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/catalog_surface_gradient"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">
            <com.pharmasiu.mobile.ui.customer.catalog.HomeBannerCarousel
                android:id="@+id/catalog_home_banner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:elevation="0dp" />
            <LinearLayout android:id="@+id/catalog_v2_home_shortcuts" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:paddingHorizontal="12dp" android:paddingTop="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center_vertical"
                android:paddingHorizontal="12dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Dành cho bạn" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold" android:accessibilityHeading="true"/>
                <TextView android:id="@+id/catalog_v2_home_all" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
                    android:paddingStart="12dp" android:text="Xem tất cả" android:textColor="@color/emerald"
                    android:textSize="14sp" android:textStyle="bold" android:background="@drawable/catalog_market_card_focus" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fillViewport="false" android:scrollbars="none">
                <LinearLayout android:id="@+id/catalog_v2_home_shelves" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingHorizontal="12dp" android:paddingBottom="12dp"/>
            </HorizontalScrollView>
            <LinearLayout android:id="@+id/catalog_v2_home_grid" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/catalog_v2_home_open_catalog"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp"
                android:paddingVertical="12dp" android:text="Xem toàn bộ danh mục" android:textSize="16sp"
                android:textAllCaps="false" android:backgroundTint="@color/emerald" android:textColor="@color/white"
                app:cornerRadius="16dp" app:icon="@drawable/ic_arrow_forward" app:iconGravity="textEnd" app:iconTint="@color/white"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

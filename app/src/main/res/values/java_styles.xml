<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Java Views + official Material 3: brand colors deliberately static for predictability. -->
    <style name="Theme.PharmaSIUJava" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/emerald</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/lime</item>
        <item name="colorOnSecondary">@color/forest</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/mint</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/control_outline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:editTextColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/emerald</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="TextAppearance.Pharma.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Pharma.Navigation.Active" parent="TextAppearance.Pharma.Navigation">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
